# Supabase — get these from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Notes:
# - NEXT_PUBLIC_* variables are visible in the browser. Safe to expose.
# - SUPABASE_SERVICE_ROLE_KEY bypasses RLS. Keep it server-side only.
#   Never prefix it with NEXT_PUBLIC_. Never use it in client components.
